{
  "$defs": {
    "Artifact": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "title": "Artifact Id",
          "type": "string"
        },
        "fact_ids": {
          "items": {
            "type": "string"
          },
          "title": "Fact Ids",
          "type": "array"
        },
        "kind": {
          "$ref": "#/$defs/ArtifactKind",
          "default": "document"
        },
        "media_type": {
          "default": "application/octet-stream",
          "title": "Media Type",
          "type": "string"
        },
        "meta": {
          "additionalProperties": true,
          "title": "Meta",
          "type": "object"
        },
        "origin": {
          "$ref": "#/$defs/Origin",
          "default": "derived"
        },
        "producer": {
          "default": "",
          "title": "Producer",
          "type": "string"
        },
        "size_bytes": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Size Bytes"
        },
        "source_ids": {
          "description": "SourceRef ids this artifact is derived from",
          "items": {
            "type": "string"
          },
          "title": "Source Ids",
          "type": "array"
        },
        "title": {
          "default": "",
          "title": "Title",
          "type": "string"
        },
        "uri": {
          "description": "Path relative to WORKSTATION_HOME, or absolute URL",
          "title": "Uri",
          "type": "string"
        }
      },
      "required": [
        "uri"
      ],
      "title": "Artifact",
      "type": "object"
    },
    "ArtifactKind": {
      "enum": [
        "document",
        "deck",
        "markdown",
        "image",
        "table",
        "json",
        "report"
      ],
      "title": "ArtifactKind",
      "type": "string"
    },
    "Budget": {
      "additionalProperties": false,
      "description": "Hard ceilings. Exceeding one is a run failure, never a silent overrun.",
      "properties": {
        "max_cost_cny": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Cost Cny"
        },
        "max_llm_calls": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Llm Calls"
        },
        "max_tokens": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Tokens"
        },
        "max_tool_calls": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Tool Calls"
        },
        "max_wall_clock_s": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Wall Clock S"
        }
      },
      "title": "Budget",
      "type": "object"
    },
    "Origin": {
      "description": "Backup policy class.\n\n``primary`` cannot be rebuilt from anything else -- losing it is data loss.\n``derived`` is a cache and may be deleted at any time.",
      "enum": [
        "primary",
        "derived"
      ],
      "title": "Origin",
      "type": "string"
    },
    "Priority": {
      "description": "Interactive beats batch. Mirrors research_agent's reserved-slot model.",
      "enum": [
        "interactive",
        "normal",
        "batch"
      ],
      "title": "Priority",
      "type": "string"
    },
    "RunStatus": {
      "enum": [
        "pending",
        "running",
        "waiting",
        "succeeded",
        "failed",
        "cancelled",
        "partial"
      ],
      "title": "RunStatus",
      "type": "string"
    },
    "Step": {
      "additionalProperties": false,
      "properties": {
        "ended_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ended At"
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error"
        },
        "kind": {
          "$ref": "#/$defs/StepKind",
          "default": "tool"
        },
        "message": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Message"
        },
        "meta": {
          "additionalProperties": true,
          "title": "Meta",
          "type": "object"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "started_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Started At"
        },
        "status": {
          "$ref": "#/$defs/StepStatus",
          "default": "pending"
        },
        "step_id": {
          "title": "Step Id",
          "type": "string"
        },
        "usage": {
          "$ref": "#/$defs/Usage"
        }
      },
      "required": [
        "name"
      ],
      "title": "Step",
      "type": "object"
    },
    "StepKind": {
      "enum": [
        "llm",
        "tool",
        "retrieve",
        "render",
        "verify",
        "write"
      ],
      "title": "StepKind",
      "type": "string"
    },
    "StepStatus": {
      "enum": [
        "pending",
        "running",
        "succeeded",
        "failed",
        "skipped",
        "cancelled"
      ],
      "title": "StepStatus",
      "type": "string"
    },
    "TaskOptions": {
      "additionalProperties": false,
      "properties": {
        "budget": {
          "$ref": "#/$defs/Budget"
        },
        "dry_run": {
          "default": false,
          "title": "Dry Run",
          "type": "boolean"
        },
        "idempotency_key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Re-issuing the same key returns the existing run",
          "title": "Idempotency Key"
        },
        "locale": {
          "default": "zh-CN",
          "title": "Locale",
          "type": "string"
        },
        "priority": {
          "$ref": "#/$defs/Priority",
          "default": "normal"
        },
        "require_approval": {
          "default": false,
          "description": "Block before any fs:primary or vault:write side effect",
          "title": "Require Approval",
          "type": "boolean"
        },
        "timeout_s": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Timeout S"
        }
      },
      "title": "TaskOptions",
      "type": "object"
    },
    "Usage": {
      "additionalProperties": false,
      "description": "Accounting for one step or one whole run.",
      "properties": {
        "completion_tokens": {
          "default": 0,
          "title": "Completion Tokens",
          "type": "integer"
        },
        "cost_cny": {
          "default": 0.0,
          "title": "Cost Cny",
          "type": "number"
        },
        "llm_calls": {
          "default": 0,
          "title": "Llm Calls",
          "type": "integer"
        },
        "prompt_tokens": {
          "default": 0,
          "title": "Prompt Tokens",
          "type": "integer"
        },
        "retries": {
          "default": 0,
          "title": "Retries",
          "type": "integer"
        },
        "tool_calls": {
          "default": 0,
          "title": "Tool Calls",
          "type": "integer"
        },
        "wall_clock_s": {
          "default": 0.0,
          "title": "Wall Clock S",
          "type": "number"
        }
      },
      "title": "Usage",
      "type": "object"
    }
  },
  "$id": "https://workstation.local/schema/run.schema.json",
  "additionalProperties": false,
  "description": "One execution of one skill.",
  "properties": {
    "artifacts": {
      "items": {
        "$ref": "#/$defs/Artifact"
      },
      "title": "Artifacts",
      "type": "array"
    },
    "checkpoint_ref": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "langgraph thread id / subprocess workdir / opaque token",
      "title": "Checkpoint Ref"
    },
    "context": {
      "default": "default",
      "title": "Context",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "ended_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Ended At"
    },
    "error": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error"
    },
    "idempotency_key": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Idempotency Key"
    },
    "inputs": {
      "additionalProperties": true,
      "title": "Inputs",
      "type": "object"
    },
    "options": {
      "$ref": "#/$defs/TaskOptions"
    },
    "outputs": {
      "additionalProperties": true,
      "title": "Outputs",
      "type": "object"
    },
    "parent_run_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Parent Run Id"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "skill": {
      "title": "Skill",
      "type": "string"
    },
    "skill_version": {
      "default": "0.0.0",
      "title": "Skill Version",
      "type": "string"
    },
    "source_ids": {
      "description": "Every SourceRef touched, for citation back-fill",
      "items": {
        "type": "string"
      },
      "title": "Source Ids",
      "type": "array"
    },
    "started_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Started At"
    },
    "status": {
      "$ref": "#/$defs/RunStatus",
      "default": "pending"
    },
    "steps": {
      "items": {
        "$ref": "#/$defs/Step"
      },
      "title": "Steps",
      "type": "array"
    },
    "task_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Task Id"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    },
    "usage": {
      "$ref": "#/$defs/Usage"
    }
  },
  "required": [
    "skill"
  ],
  "title": "Run",
  "type": "object",
  "x-contract-version": "0.1.0"
}
